# WinSmartControl - Configuration d'environnement (Modèle)
# Copier ce fichier vers .env pour personnaliser votre environnement local.
# Le fichier .env est protégé et exclu du contrôle de version Git.

# Mode cible Smart App Control par défaut (Evaluation | Enforce | Off)
WINSMARTCONTROL_TARGET_MODE=Evaluation

# Activer l'entraînement automatique des outils développeurs (True | False)
WINSMARTCONTROL_AUTO_TRAIN=True

# Répertoires de développement à placer en confiance et exclusion Defender
# Chemins séparés par des points-virgules
WINSMARTCONTROL_DEV_PATHS="G:\Mon Drive\05_Dev;C:\Users\geoff\.gemini;C:\Users\geoff\.gemini\antigravity\bin"

# Activer le Mode Développeur Windows (True | False)
WINSMARTCONTROL_ENABLE_DEV_MODE=True

# Dossier d'export des rapports d'audit Code Integrity
WINSMARTCONTROL_LOG_DIR=logs
