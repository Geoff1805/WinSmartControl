Windows Registry Editor Version 5.00

; WinSmartControl - Bascule de Smart App Control (SAC) en Mode Evaluation / Apprentissage
; Valeur 2 = Mode Evaluation (audit sans blocage, apprentissage telemetrique)
; Valeur 1 = Enforce (bloquant)
; Valeur 0 = Desactive

[HKEY_LOCAL_MACHINE\SYSTEM\CurrentControlSet\Control\CI\Policy]
"VerifiedAndReputablePolicyState"=dword:00000002
"SAC_PreviousState"=dword:00000001
